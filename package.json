{
  "name": "rampes-gardex-app",
  "version": "0.1.0",
  "private": true,
 
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start -p $PORT -H 0.0.0.0",
    "lint": "eslint",
    "migrate:clients": "tsx scripts/migrate-clients.ts",
    "migrate:clients:cleanup": "tsx scripts/cleanup-clients-duplicates.ts",
    "migrate:representants": "tsx scripts/migrate-representants.ts",
    "migrate:commandes": "tsx scripts/migrate-commandes.ts",
    "migrate:fournisseurs": "ts-node scripts/migrate-fournisseurs.ts",
    "migrate:non-conformites": "ts-node scripts/migrate-NC.ts",
    "migrate:categories": "ts-node scripts/migrate-categories.ts",
    "migrate:unites": "ts-node scripts/migrate-unites.ts",
    "migrate:pieces": "ts-node scripts/migrate-pieces.ts",
    "migrate:transactions": "ts-node scripts/migrate-transactions.ts",
    "migrate:all": "ts-node scripts/migrateAll.ts",
    "postinstall": "prisma generate"
    
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@eslint-community/eslint-utils": "^4.9.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^6.19.2",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "isomorphic-fetch": "^3.0.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio": "^5.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^20.19.37",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^10.0.0",
    "eslint-config-next": "^0.2.4",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "migrations": {
      "path": "prisma/migrations",
      "seed": "ts-node prisma/seed.ts"
    }
  },
  "crons": [
    {
      "path": "/api/reprises/cron-conseils",
      "schedule": "0 8 */3 * *"
    },
    {
      "path": "/api/attentes/cron",
      "schedule": "0 8 * * 1"
    }
  ]
}
